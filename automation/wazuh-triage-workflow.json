    {
      "parameters": {
        "fromEmail": "YOUR_EMAIL@gmail.com",
        "toEmail": "YOUR_EMAIL@gmail.com",
        "subject": "=[SOC ALERT] Malicious IOC - {{ $json.description }}",
        "emailFormat": "text",
        "text": "=SOC AUTOMATED ALERT - MALICIOUS VERDICT\n\nRule: {{ $('Extract IOC').item.json.rule_id }} - {{ $('Extract IOC').item.json.description }}\nSeverity: {{ $('Extract IOC').item.json.level }}\nMITRE: {{ $('Extract IOC').item.json.mitre.id }}\nAgent: {{ $('Extract IOC').item.json.agent.name }} ({{ $('Extract IOC').item.json.agent.ip }})\nIOC IP: {{ $('Extract IOC').item.json.ioc_ip }}\nVirusTotal malicious count: {{ $('VirusTotal Lookup').item.json.data.attributes.last_analysis_stats.malicious }}\n\nVerdict: MALICIOUS - analyst review required.",
