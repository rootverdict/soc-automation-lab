    {
      "parameters": {
        "jsCode": "// RESPONSE GATE - the \"should we contain this?\" decision.\n//\n//   severity == 10  AND  ( VirusTotal malicious  OR  a correlation rule fired )\n//\n// The correlation clause matters because a brute-force or sudo-abuse pattern is\n// high-confidence on its own, and those alerts are usually RFC1918 (so VT was\n// skipped and there is no reputation signal to lean on).\nconst alert = $('Extract IOC').first().json;\n\nconst level = Number(alert.level ?? 0);\nconst ruleId = String(alert.rule_id ?? '');\nconst verdict = String($json.verdict ?? '');\n\nconst vtMalicious = verdict === 'MALICIOUS';\nconst correlation = ['100002', '100011'].includes(ruleId);\n\nreturn [{\n  json: {\n    ...alert,\n    verdict,\n    vt_malicious: vtMalicious,\n    correlation_rule: correlation,\n    do_respond: level === 10 && (vtMalicious || correlation)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        96
      ],
      "id": "c4a1e6d2-9f37-4b58-8a10-5e2d7c3b9f41",
      "name": "Response Gate"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "b7f2c918-3d64-4a52-9c81-7e0f5a2d6b93",
              "leftValue": "={{ $json.do_respond }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1456,
        96
      ],
      "id": "a913d5f7-2c48-4e69-b3d0-8f61a4c7e250",
      "name": "Should Respond?"
    },
    {
      "parameters": {
        "jsCode": "// DEDUP GUARD - stop a response storm.\n//\n// A brute-force burst produces several correlated alerts in quick succession;\n// each one must not launch its own remediation. Workflow static data acts as a\n// short-lived per-host suppression cache.\nconst key = `resp:${$json.agent?.name ?? 'unknown'}`;\nconst now = Date.now();\nconst store = $getWorkflowStaticData('global');\nconst last = store[key] ?? 0;\n\nif (now - last < 5 * 60 * 1000) {   // 5-minute suppression window\n  return [];                        // duplicate -> drop, no response\n}\n\nstore[key] = now;\nreturn [{ json: $json }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1664,
        96
      ],
      "id": "f2e8b471-6a09-4d3c-95b2-1c7d3e8f0a56",
      "name": "Dedup Guard"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://192.168.100.20:8889/api/v1/CollectArtifact",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"client_id\": \"{{ $json.agent.id }}\",\n  \"artifacts\": [\"Custom.Remediation.KillProcess\"],\n  \"specs\": [\n    {\n      \"artifact\": \"Custom.Remediation.KillProcess\",\n      \"parameters\": {\n        \"env\": [\n          { \"key\": \"DryRun\", \"value\": \"Y\" }\n        ]\n      }\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1872,
        96
      ],
      "id": "d6c0a382-4f15-4b73-8e29-0b5a91f2c748",
      "name": "Velociraptor Remediation",
      "notesInFlow": true,
      "notes": "DryRun=Y - reports what it would kill, takes no destructive action. ProcName is deliberately NOT sent: the artifact's default matches nothing, and an empty value would match every process once DryRun is turned off. Supply a specific ProcName only for alert types that actually name a process.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_VELOCIRAPTOR_CREDENTIAL",
          "name": "Velociraptor API"
        }
      }
    }
