    {
      "parameters": {
        "jsCode": "// Extract the IOC from the Wazuh alert and classify it internal vs public.\n//\n// LAB LIMITATION: every real source IP in this lab is RFC1918, so the\n// VirusTotal branch is exercised by injecting a known public IOC. Leave\n// TEST_IOC null for normal operation - see architecture/README.md, \"Network\n// note\". (Previously this override was hardcoded ON, which meant the\n// extraction below never actually ran.)\nconst TEST_IOC = null;   // e.g. \"45.155.205.233\" to exercise the malicious path\n\nconst alert = $input.first().json.body || $input.first().json;\n\n// Wazuh writes the source IP into the raw log line for sshd events.\nconst match = (alert.full_log || \"\").match(/from (\\d+\\.\\d+\\.\\d+\\.\\d+)/);\nconst ip = TEST_IOC || (match ? match[1] : (alert.agent?.ip || null));\n\n// RFC1918 + loopback. A private address has no useful public reputation, so it\n// is routed away from VirusTotal instead of burning API quota.\nconst isPrivate = !ip || /^(10\\.|127\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[01])\\.)/.test(ip);\n\nreturn [{\n  json: {\n    rule_id: alert.rule_id,\n    description: alert.description,\n    level: alert.level,\n    mitre: alert.mitre,\n    agent: alert.agent,\n    ioc_ip: ip,\n    is_private: isPrivate\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "6260c10b-29df-43c3-8920-1e30d88b6e59",
      "name": "Extract IOC"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "d2031bc9-87c4-444a-b144-465db9a5a1d0",
              "leftValue": "={{ $json.is_private }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
